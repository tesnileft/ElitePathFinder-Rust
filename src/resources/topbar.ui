<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <template class="EliteHeaderBar" parent="GtkBox">
        <property name="hexpand">true</property>
        <child>
            <object class="GtkOverlay" id="location_overlay">
                <child>
                    <object class="GtkCenterBox" id="topbar_box">
                        <property name="hexpand">true</property>
                        <child type="center">
                            <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <child>
                                    <object class="GtkLabel" id="systemname_label">
                                        <property name="label">[System Name]</property>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkLabel" id="locationname_label">
                                        <property name="label">[Location Name]</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child type="end">
                            <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <child>
                                    <object class="GtkBox">
                                        <child>
                                            <object class="GtkLabel">
                                                <property name="label">CMDR:</property>
                                            </object>
                                        </child>
                                        <child>
                                            <object class="GtkLabel" id="commandername_label">
                                                <property name="label">[Name]</property>
                                            </object>
                                        </child>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkBox">
                                        <child>
                                            <object class="GtkImage">
                                                <property name="resource">/elite_pathfinder/icons/arx_logo.png</property>
                                                <property name="margin-end">12</property>
                                            </object>
                                        </child>
                                        <child>
                                            <object class="GtkLabel" id="arx_label">
                                                <property name="label">42069</property>
                                                <property name="halign">end</property>
                                            </object>
                                        </child>

                                    </object>

                                </child>
                                <child>
                                    <object class="GtkLabel" id="credits_label">
                                        <property name="label">Credits: 2</property>
                                        <property name="halign">end</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </child>
                <child type="overlay">
                    <object class="GtkBox" id="jump_overlay_box">
                        <property name="halign">center</property>
                        <property name="valign">fill</property>
                        <property name="visible">false</property>
                        <style>
                            <class name="jump-overlay"/>
                        </style>
                        <child>
                            <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">8</property>
                                <property name="halign">center</property>
                                <property name="valign">center</property>
                                <property name="hexpand">false</property>
                                <property name="vexpand">true</property>
                                <child>
                                    <object class="GtkSpinner" id="jump_spinner">
                                        <property name="spinning">false</property>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkLabel" id="jump_status_label">
                                        <property name="label">Charging FSD…</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>
    </template>
</interface>